{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esNext",
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "scripts/**/*",
    "*/scripts/**/*",
    "baseflow-nodes/*/scripts/**/*",
    "*/vite.config.ts",
    "*/vite.shared.config.ts",
    "baseflow-nodes/*/vite.config.ts"
  ],
  "exclude": ["**/node_modules", "baseflow-preview"]
}
