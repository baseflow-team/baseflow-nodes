{
  "name": "baseflow-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "type:check": "tsc --noEmit",
    "lint": "biome check . && stylelint \"./src/**/*.scss\"",
    "lint:fix": "biome check --write . && stylelint \"./src/**/*.scss\" --fix",
    "mock:generate": "node ./scripts/generateMock.js",
    "monaco:copy": "node ./scripts/copyMonaco.js",
    "preview:clean": "node ./scripts/cleanPreview.js",
    "prebuild": "npm run preview:clean && npm run mock:generate",
    "predev": "npm run mock:generate",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-json-view-lite": "^2.5.0",
    "markdown-to-jsx": "^9.10.2",
    "fast-xml-parser": "^5.11.0",
    "fast-xml-builder": "^1.3.1",
    "@baseflow/flow-react": "^1.0.0",
    "widgets-antd": "*",
    "axios": "*",
    "lucide-react": "*",
    "antd": "*"
  },
  "dependencies": {
    "reactflow": "^11.11.4"
  }
}
