{
  "@baseflow-nodes/branch": {
    "type": "Branch",
    "name": "条件分支",
    "icon": "",
    "desc": "条件分支：放置于[条件选择]中，通过设置执行条件来决定是否执行",
    "dsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/branch\"}],\"sources\":{\"@baseflow-nodes/branch\":\"@baseflow-nodes/branch@*\"}}"
  },
  "@baseflow-nodes/break": {
    "type": "Break",
    "name": "循环Break",
    "icon": "",
    "desc": "循环Break：放置于[循环]节点中，退出整个循环",
    "dsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/break\"}],\"sources\":{\"@baseflow-nodes/break\":\"@baseflow-nodes/break@*\"}}"
  },
  "@baseflow-nodes/choice": {
    "type": "Choice",
    "name": "条件选择",
    "icon": "",
    "desc": "条件选择：可添加多个[条件分支]，通过条件判断来控制分支执行",
    "dsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/choice\",\"id\":\"choice1\",\"childrenIds\":[\"branch1\",\"branch2\"]},{\"tag\":\"@baseflow-nodes/branch\",\"id\":\"branch1\",\"parentId\":\"choice1\"},{\"tag\":\"@baseflow-nodes/branch\",\"id\":\"branch2\",\"parentId\":\"choice1\",\"props\":{\"default\":true}}],\"sources\":{\"@baseflow-nodes/choice\":\"@baseflow-nodes/choice@*\",\"@baseflow-nodes/branch\":\"@baseflow-nodes/branch@*\"}}"
  },
  "@baseflow-nodes/continue": {
    "type": "Break",
    "name": "循环Continue",
    "icon": "",
    "desc": "循环Continue：放置于[循环]节点中，跳过本次循环，继续下一次循环",
    "dsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/continue\"}],\"sources\":{\"@baseflow-nodes/continue\":\"@baseflow-nodes/continue@*\"}}"
  },
  "@baseflow-nodes/flow": {
    "type": "Flow",
    "name": "流程",
    "icon": "",
    "desc": "流程：定义一个独立的流程",
    "dsl": "{\"nodes\":[],\"sources\":{}}"
  },
  "@baseflow-nodes/parallel": {
    "type": "Parallel",
    "name": "并行执行",
    "icon": "",
    "desc": "并行执行：可添加多个[并行分支]，多个并行分支同时执行",
    "dsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/parallel\",\"id\":\"parallel1\",\"childrenIds\":[\"thread1\",\"thread2\"]},{\"tag\":\"@baseflow-nodes/thread\",\"id\":\"thread1\",\"parentId\":\"parallel1\"},{\"tag\":\"@baseflow-nodes/thread\",\"id\":\"thread2\",\"parentId\":\"parallel1\"}],\"sources\":{\"@baseflow-nodes/parallel\":\"@baseflow-nodes/parallel@*\",\"@baseflow-nodes/thread\":\"@baseflow-nodes/thread@*\"}}"
  },
  "@baseflow-nodes/thread": {
    "type": "Thread",
    "name": "并行分支",
    "icon": "",
    "desc": "并行分支：放置于[并行执行]中，多个并行分支同时执行",
    "dsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/thread\"}],\"sources\":{\"@baseflow-nodes/thread\":\"@baseflow-nodes/thread@*\"}}"
  },
  "@baseflow-nodes/try-catch": {
    "type": "Group",
    "name": "TryCatch",
    "icon": "",
    "desc": "TryCatch：提供一个可以捕获子节点运行时错误的容器节点",
    "dsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/try-catch\"}],\"sources\":{\"@baseflow-nodes/try-catch\":\"@baseflow-nodes/try-catch@*\"}}"
  }
}
