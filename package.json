{
  "name": "baseflow-nodes-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "widgets-antd",
    "baseflow-demo",
    "baseflow-nodes/*"
  ],
  "baseflowRuntimeVersion": "1",
  "scripts": {
    "test": "vitest run",
    "type:check": "tsc --noEmit && npm run type:check --workspaces --if-present",
    "lint": "biome check . && stylelint \"**/*.{css,scss}\"",
    "lint:fix": "biome check --write . && stylelint \"**/*.{css,scss}\" --fix",
    "prepare:monaco": "node ./scripts/assertWorkspaceRoot.js && npm run monaco:copy --workspace baseflow-demo",
    "build:demo": "node ./scripts/assertWorkspaceRoot.js && npm run build --workspace baseflow-demo",
    "build:renderer": "node ./scripts/assertWorkspaceRoot.js && node ./scripts/verifyPreview.js --shared && npm run build:app --workspace baseflow-node-renderer",
    "build:nodes": "node ./scripts/assertWorkspaceRoot.js && node ./scripts/buildNodes.js",
    "preview": "npm run preview --workspace baseflow-demo"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-json-view-lite": "^2.5.0",
    "markdown-to-jsx": "^9.10.2",
    "fast-xml-parser": "^5.11.0",
    "fast-xml-builder": "^1.3.1",
    "@baseflow/flow-react": "^1.0.6",
    "@baseflow/node-runtime-react": "^1.0.7",
    "antd": "^6.6.1",
    "dayjs": "^1",
    "axios": "^1.18.1",
    "mutative": "^1.3.0",
    "classnames": "^2.5.1",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@biomejs/biome": "^2.5.10",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "typescript": "^5.9.0",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.5.1",
    "vite": "~8.2.2",
    "vitest": "~4.1.0",
    "jsdom": "~29.1.1",
    "@vitejs/plugin-react": "^6.1.0",
    "monaco-editor": "^0.56.0",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
