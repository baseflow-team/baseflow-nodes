{
  "name": "baseflow-nodes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "app",
    "nodes/*"
  ],
  "scripts": {
    "build:type": "npm run build:type --workspaces --if-present",
    "type:check": "tsc --noEmit && npm run type:check --workspaces --if-present",
    "lint": "biome check . && stylelint \"packages/*/src/**/*.{css,scss}\"",
    "lint:fix": "biome check --write . && stylelint \"packages/*/src/**/*.{css,scss}\" --fix",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "antd": "^6.6.1",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "mutative": "^1.3.0",
    "fast-xml-parser": "^5.11.0",
    "fast-xml-builder": "^1.3.1",
    "classnames": "^2.5.1",
    "markdown-to-jsx": "^9.10.2",
    "lucide-react": "^1.31.0",
    "@baseflow/flow-react": "0.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@biomejs/biome": "^2.5.10",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.5.1",
    "vite": "~8.2.2",
    "vitest": "~4.1.0",
    "jsdom": "^26.1.0",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1"
  }
}
