{
  "name": "@baseflow-nodes/choice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "baseflow": {
    "runtimeVersion": "1",
    "icon": "",
    "desc": "条件选择：可添加多个[条件分支]，通过条件判断来控制分支执行",
    "executor": {
      "node": "@baseflow-executors/choice@0.0.1"
    },
    "defaultDsl": {
      "nodes": [
        {
          "tag": "@baseflow-nodes/choice",
          "id": "choice1",
          "childrenIds": [
            "branch1",
            "branch2"
          ]
        },
        {
          "tag": "@baseflow-nodes/branch",
          "id": "branch1",
          "parentId": "choice1"
        },
        {
          "tag": "@baseflow-nodes/branch",
          "id": "branch2",
          "parentId": "choice1",
          "props": {
            "default": true
          }
        }
      ],
      "sources": {
        "@baseflow-nodes/choice": "@baseflow-nodes/choice@1",
        "@baseflow-nodes/branch": "@baseflow-nodes/branch@1"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/buildNodeManifest.js",
    "type:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@baseflow/node-runtime-react": "^1"
  }
}
