{
  "name": "@baseflow-nodes/choice",
  "version": "0.0.1",
  "private": true,
  "baseflow": {
    "type": "Choice",
    "icon": "",
    "desc": "条件选择：可添加多个[条件分支]，通过条件判断来控制分支执行",
    "executor": {
      "node": "@baseflow-executors/choice@0.0.1"
    },
    "defaultData": {
      "meta": {
        "name": "条件选择"
      },
      "props": {}
    },
    "defalutDsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/choice\",\"id\":\"choice1\",\"childrenIds\":[\"branch1\",\"branch2\"]},{\"tag\":\"@baseflow-nodes/branch\",\"id\":\"branch1\",\"parentId\":\"choice1\"},{\"tag\":\"@baseflow-nodes/branch\",\"id\":\"branch2\",\"parentId\":\"choice1\",\"props\":{\"default\":true}}],\"sources\":{\"@baseflow-nodes/choice\":\"@baseflow-nodes/choice@*\",\"@baseflow-nodes/branch\":\"@baseflow-nodes/branch@*\"}}"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rollup -c ../../../scripts/rollup.config.js",
    "publish": "npm publish ../../../public/nodes/choice"
  }
}
