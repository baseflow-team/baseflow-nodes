{
  "name": "@baseflow-nodes/parallel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "baseflow": {
    "name": "并行执行",
    "type": "Parallel",
    "runtimeVersion": "1",
    "icon": "",
    "desc": "并行执行：可添加多个[并行分支]，多个并行分支同时执行",
    "executor": {
      "node": "@baseflow-executors/parallel@0.0.1"
    },
    "defaultDsl": {
      "node": {
        "tag": "@baseflow-nodes/parallel",
        "meta": {
          "name": "并行执行"
        },
        "props": {},
        "children": [
          {
            "tag": "@baseflow-nodes/thread",
            "meta": {
              "name": "并行分支1"
            },
            "props": {}
          },
          {
            "tag": "@baseflow-nodes/thread",
            "meta": {
              "name": "并行分支2"
            },
            "props": {}
          }
        ]
      },
      "sources": {
        "@baseflow-nodes/parallel": "@baseflow-nodes/parallel@1",
        "@baseflow-nodes/thread": "@baseflow-nodes/thread@1"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/buildNodeManifest.js",
    "type:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@baseflow/node-runtime-react": "^1"
  }
}
