{
  "name": "@baseflow-nodes/branch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "baseflow": {
    "name": "条件分支",
    "type": "Branch",
    "runtimeVersion": "1",
    "icon": "",
    "desc": "条件分支：放置于[条件选择]中，通过设置执行条件来决定是否执行",
    "executor": {
      "node": "@baseflow-executors/branch@0.0.1"
    },
    "defaultDsl": {
      "nodes": [
        {
          "tag": "@baseflow-nodes/branch"
        }
      ],
      "sources": {
        "@baseflow-nodes/branch": "@baseflow-nodes/branch@1"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/buildNodeManifest.js && vite build",
    "type:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@mantine/core": "^9",
    "widgets-mantine": "*",
    "@baseflow/node-runtime-react": "^1"
  }
}
