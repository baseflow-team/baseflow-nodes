{
  "name": "@baseflow-nodes/end",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "baseflow": {
    "name": "流程结束",
    "type": "End",
    "runtimeVersion": "1",
    "icon": "",
    "desc": "流程结束：流程正常执行完成，可以设置返回数据",
    "executor": {
      "node": "@baseflow-executors/end@0.0.1"
    },
    "defaultDsl": {
      "node": {
        "tag": "@baseflow-nodes/end",
        "meta": {
          "name": "流程结束",
          "watchExternalProps": {
            "flow": {
              "outputSchema": "The flowReturnSchema has been modified and needs to be confirmed"
            }
          }
        },
        "props": {}
      },
      "sources": {
        "@baseflow-nodes/end": "@baseflow-nodes/end@1"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/buildNodeManifest.js && vite build",
    "type:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@mantine/core": "^9",
    "widgets-mantine": "*",
    "@baseflow/node-runtime-react": "^1"
  }
}
