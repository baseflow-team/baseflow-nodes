        {
          "tag": "@baseflow-nodes/variable-update"
        }
      ],
      "sources": {
        "@baseflow-nodes/variable-update": "@baseflow-nodes/variable-update@1"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/buildNodeManifest.js && vite build",
    "type:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "antd": "*",
    "widgets-antd": "*",
    "@baseflow/node-runtime-react": "^1"
  }
}
