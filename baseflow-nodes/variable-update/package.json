{
  "name": "@baseflow-nodes/variable-update",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "baseflow": {
    "icon": "",
    "desc": "变量修改：通过本节点可以修改[变量定义]节点中的变量值.",
    "executor": {
      "node": "@baseflow-executors/variable-update@0.0.1"
    },
    "defaultDsl": {
