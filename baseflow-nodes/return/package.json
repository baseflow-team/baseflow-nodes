{
  "name": "@baseflow-nodes/return",
  "version": "0.0.1",
  "private": true,
  "baseflow": {
    "type": "Return",
    "icon": "",
    "desc": "流程返回：流程提前终止执行并返回，可以设置返回数据",
    "executor": {
      "node": "@baseflow-executors/return@0.0.1"
    },
    "defaultData": {
      "meta": {
        "name": "流程返回",
        "valueReference": {
          "path": "flow"
        }
      },
      "props": {}
    },
    "defalutDsl": "{\"nodes\":[{\"tag\":\"@baseflow-nodes/return\"}],\"sources\":{\"@baseflow-nodes/return\":\"@baseflow-nodes/return@0.0.1\"}}"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rollup -c ../../../scripts/rollup.config.js",
    "publish": "npm publish ../../../public/nodes/return"
  }
}
