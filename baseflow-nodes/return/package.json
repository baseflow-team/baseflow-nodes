{
  "name": "@baseflow-nodes/return",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "baseflow": {
    "name": "流程返回",
    "type": "Return",
    "runtimeVersion": "1",
    "icon": "",
    "desc": "流程返回：流程提前终止执行并返回，可以设置返回数据",
    "executor": {
      "node": "@baseflow-executors/return@0.0.1"
    },
    "defaultDsl": {
      "nodes": [
        {
          "tag": "@baseflow-nodes/return"
        }
      ],
      "sources": {
        "@baseflow-nodes/return": "@baseflow-nodes/return@0.0.1"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/buildNodeManifest.js && vite build",
    "type:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@mantine/core": "^9",
    "widgets-mantine": "*",
    "@baseflow/node-runtime-react": "^1"
  }
}
