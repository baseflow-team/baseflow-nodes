{
  "name": "baseflow-node-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "type:check": "tsc --noEmit",
    "lint": "biome check . && stylelint \"./src/**/*.scss\"",
    "lint:fix": "biome check --write . && stylelint \"./src/**/*.scss\" --fix",
    "dev": "vite",
    "build:shared": "vite build --config vite.shared.config.ts",
    "build:app": "vite build",
    "build": "npm run build:shared && npm run build:app",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*",
    "antd": "*",
    "dayjs": "*",
    "@baseflow/render-react": "*"
  }
}
